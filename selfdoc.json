{
  "version": "0.10.2",
  "source": [
    {
      "path": ".",
      "language": "go"
    },
    {
      "path": "internal/archive",
      "language": "go"
    },
    {
      "path": "internal/db",
      "language": "go"
    },
    {
      "path": "internal/git",
      "language": "go"
    },
    {
      "path": "internal/meta",
      "language": "go"
    },
    {
      "path": "internal/trace",
      "language": "go"
    }
  ],
  "docs": ".strictmetadata/docs/",
  "output": ".strictmetadata/.docs-cache/build/",
  "base_url": "https://smmh.dev/saferm",
  "description": "The `rm` replacement that is safe to hand to your AI Agents: deleted files can be restored, know exactly which session deleted a file, when, and why, with the reason being a required flag",
  "repo": "https://github.com/stricttools/saferm",
  "search_engine": "pagefind",
  "author": {
    "name": "SMMH",
    "url": "https://smmh.dev",
    "same_as": [
      "https://github.com/smm-h"
    ]
  },
  "versions": [
    {
      "version": "0.10.2"
    }
  ],
  "locales": [
    {
      "code": "en",
      "label": "English",
      "default": true
    }
  ],
  "directives": {
    "table-exit-codes": ".strictmetadata/docs/_directives/exit_codes.py"
  },
  "root_files": [
    ".strictmetadata/docs/_CLAUDE.md",
    ".strictmetadata/docs/_README.md"
  ],
  "gen": {
    "exclude": [
      "*"
    ]
  },
  "topology": {
    "slug": "saferm",
    "docs_base": "https://smmh.dev",
    "posts_base": "https://blog.smmh.dev"
  },
  "assembly": {
    "repo": "smm-h/selfdoc-cache"
  }
}
